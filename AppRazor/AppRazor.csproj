<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5e68a998-baf0-445e-95c7-e27afdc91e08</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'https' " />

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'http' " />

  <ItemGroup>
    <ProjectReference Include="..\Models\Models.csproj">
      <GlobalPropertiesToRemove />
    </ProjectReference>
    <ProjectReference Include="..\Configuration\Configuration.csproj">
      <GlobalPropertiesToRemove />
    </ProjectReference>
    <ProjectReference Include="..\Encryptions\Encryptions.csproj">
      <GlobalPropertiesToRemove />
    </ProjectReference>
    <ProjectReference Include="..\DbContext\DbContext.csproj">
      <GlobalPropertiesToRemove />
    </ProjectReference>
    <ProjectReference Include="..\Services\Services.csproj">
      <GlobalPropertiesToRemove />
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="wwwroot\" />
    <None Remove="Pages\" />
    <None Remove="SeidoHelpers\" />
    <None Remove="TempMail\" />
    <None Remove="Pages\Account\" />
    <None Remove="Pages\Members\" />
    <None Remove="ModelAuthorization\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
    <Folder Include="Pages\" />
    <Folder Include="SeidoHelpers\" />
    <Folder Include="TempMail\" />
    <Folder Include="Pages\Account\" />
    <Folder Include="Pages\Members\" />
    <Folder Include="ModelAuthorization\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="9.0.10" />
  </ItemGroup>

</Project>